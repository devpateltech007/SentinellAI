# ComplianceLens secrets template.
# Copy this file to .env and fill in real values:   cp .env.example .env
# .env is gitignored. Never commit real tokens.

# --- GitHub (V1, V2) -----------------------------------------------------
# Fine-grained personal access token, resource owner = your test organization.
# Read-only: Repository "Administration" + "Metadata", Organization "Members".
# No write scopes.
GITHUB_TOKEN=
# The free GitHub organization that holds the test repo (GH-05, GH-06, GH-07, HR-01).
GITHUB_ORG=

# --- AWS (V1) ------------------------------------------------------------
# AWS credentials are NOT stored here. Sign in with
#   aws login --region us-east-1 --profile compliancelens
# as the read-only compliancelens-audit user, then name that profile below.
AWS_PROFILE=compliancelens
AWS_DEFAULT_REGION=us-east-1

# --- Storage (V2, optional) ----------------------------------------------
# Defaults: compliance.db and evidence/ in this folder.
# COMPLIANCELENS_DB=
# COMPLIANCELENS_EVIDENCE_DIR=

# --- Screenshots (V3) ----------------------------------------------------
# No passwords here: log in by hand once with  python audit.py login github
# (and  python audit.py login aws). The saved logins go to sessions/ (gitignored).
# Optional: keep them somewhere else instead.
# COMPLIANCELENS_SESSIONS_DIR=

# --- AI model (V4) -------------------------------------------------------
# Pick any model: write "<provider>/<model name>". Check it with: python audit.py ai-test
#   anthropic/claude-opus-5-5      (default; also claude-sonnet-5-5, claude-haiku-5-5)
#   openai/<model name>
#   ollama/<model name>            runs on this computer: free, no key
#   lmstudio/<model name>          runs on this computer: free, no key
#   compatible/<model name>        any other OpenAI-compatible service (set AI_BASE_URL)
# The key must belong to that provider. It is never printed or saved with evidence.
COMPLIANCELENS_AI_MODEL=anthropic/claude-opus-5-5
COMPLIANCELENS_AI_API_KEY=
# Optional: only for models the tool doesn't know (see compliancelens/evaluator/models.json)
# COMPLIANCELENS_AI_BASE_URL=
# COMPLIANCELENS_AI_PRICE_INPUT=        # $ per million input tokens
# COMPLIANCELENS_AI_PRICE_OUTPUT=       # $ per million output tokens
# COMPLIANCELENS_AI_TEMPERATURE=        # only for models that accept one
# COMPLIANCELENS_AI_EFFORT=             # anthropic/ only: low, medium, high, xhigh, max
# COMPLIANCELENS_AI_JSON=               # schema (provider enforces it) or prompt
# COMPLIANCELENS_AI_IMAGE_MAX_EDGE=     # pixels on the long edge
# COMPLIANCELENS_AI_IMAGE_MAX_PIXELS=
# COMPLIANCELENS_AI_MAX_TOKENS=         # answer length limit (default 8000)
# COMPLIANCELENS_AI_TIMEOUT_SECONDS=    # per call (default 120)
# Spending limits per audit run (apply to every model)
COMPLIANCELENS_AI_MAX_CALLS_PER_RUN=25
COMPLIANCELENS_AI_MAX_COST_PER_RUN_USD=2.00

# --- Dashboard (V5, not used yet) ----------------------------------------
# Single admin password for the web dashboard.
# DASHBOARD_PASSWORD=
