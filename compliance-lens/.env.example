# ComplianceLens secrets template.
# Copy this file to .env and fill in real values:   cp .env.example .env
# .env is gitignored. Never commit real tokens.

# --- GitHub (V1) ---------------------------------------------------------
# Fine-grained personal access token with READ access to "Administration"
# on your public test repo. No write scopes.
GITHUB_TOKEN=

# --- AWS (V1) ------------------------------------------------------------
# AWS credentials are NOT stored here. Run `aws configure --profile compliancelens`
# with the read-only SecurityAudit user, then name that profile below.
AWS_PROFILE=compliancelens
AWS_DEFAULT_REGION=us-east-1

# --- AI provider (V4, not used yet) --------------------------------------
# Uncomment the one you choose.
# ANTHROPIC_API_KEY=
# (Amazon Bedrock uses your AWS profile instead of a key.)

# --- Dashboard (V5, not used yet) ----------------------------------------
# Single admin password for the web dashboard.
# DASHBOARD_PASSWORD=
